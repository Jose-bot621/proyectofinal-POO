<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="600.0" prefWidth="980.0" styleClass="rol-root" stylesheets="@../css/estilo-tienda.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.SeleccionRolController">
   <children>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="26.0">
         <children>
            <Label styleClass="rol-titulo" text="👗 MODA STORE 👔" />
            <Label styleClass="rol-subtitulo" text="Tu tienda de ropa · ¿Cómo deseas ingresar?" />
            <HBox alignment="CENTER" spacing="44.0">
               <children>
                  <Button onAction="#ingresarComoComprador" prefHeight="240.0" prefWidth="340.0" styleClass="btn-rol,btn-comprador" text="🛍️  SOY COMPRADOR&#10;&#10;Mira el catálogo, arma tu carrito y compra tus prendas" textAlignment="CENTER" wrapText="true" />
                  <Button onAction="#ingresarComoVendedor" prefHeight="240.0" prefWidth="340.0" styleClass="btn-rol,btn-vendedor" text="🏷️  SOY VENDEDOR&#10;&#10;Inicia sesión, ingresa productos y registra ventas" textAlignment="CENTER" wrapText="true" />
               </children>
            </HBox>
            <Button onAction="#salir" styleClass="btn-salir-rol" text="✖ Cerrar aplicación" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</StackPane>
